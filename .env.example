DATABASE_URL=postgres://memoru:memoru@localhost:5432/memoru
TEST_DATABASE_URL=postgres://memoru:memoru@localhost:5432/memoru_test
DUMP_PATH=/path/to/ruopenlistwiki-20230301_mainspace_and_files-history.xml.7z
SEVEN_ZIP_PATH=C:/Program Files/7-Zip/7z.exe
# Picks the entry to extract from inside a multi-file dump archive (7z-compatible glob).
DUMP_ENTRY=*history.xml
# Meilisearch (etl index writes; the web app reads)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me
# Tests only; never point it at the dev instance
TEST_MEILI_URL=http://localhost:7701
# Identify yourself to the wiki: put a real contact in here before syncing
API_USER_AGENT=memoru/1.0 (+https://github.com/<your-repo>; <your-email>)
API_ENDPOINT=https://ru.openlist.wiki/api.php
API_MIN_INTERVAL_MS=1000
# Artifacts (Plan 2b). PG_TOOLS is the argv prefix that runs pg_dump/pg_restore where they
# can see ARTIFACTS_DIR as PG_TOOLS_ARTIFACTS_DIR (the compose files bind-mount it).
# The tools take the connection URL (password included) as an argument: it is visible in the
# process list of the machine that runs them.
PG_TOOLS=docker compose exec -T postgres
PG_TOOLS_ARTIFACTS_DIR=/artifacts
ARTIFACTS_DIR=.artifacts
# rsync over SSH; on Windows through a WSL distribution that has rsync and ssh installed.
RSYNC=wsl rsync
# user@host:/absolute/dir on the server, or a local directory for a rehearsal.
SHIP_TARGET=
# Optional: POST here after publish/rollback so Next.js revalidates cached pages (Plan 2c).
REVALIDATE_URL=
# Shared secret checked by POST /api/revalidate (x-revalidate-secret header).
REVALIDATE_SECRET=
